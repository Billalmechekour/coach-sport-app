SUPABASE_URL=https://your-project.supabase.co
SERVICE_ROLE_KEY=your-service-role-key

APP_NAME=Hicham-Fit App
APP_URL=https://your-public-app-url.com
APP_LOGO_URL=https://your-public-logo-url/logo.png

# Stripe (paiement des programmes payants)
# Clé secrète : sk_test_... en test, sk_live_... en production.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Choisir un provider email HTTP compatible Supabase Edge Functions: brevo, resend ou gmail
EMAIL_PROVIDER=brevo
EMAIL_FROM=noreply.hicham.fit@gmail.com
EMAIL_FROM_NAME=Hicham-Fit App

# Brevo
BREVO_API_KEY=your-brevo-api-key

# SMS Brevo transactionnel
# Sender alphanumérique 3-11 caractères, sans espace.
SMS_PROVIDER=brevo
SMS_SENDER=HichamFit

# Resend optionnel
RESEND_API_KEY=your-resend-api-key

# Gmail API optionnel, pour envoyer exactement depuis noreply.hicham.fit@gmail.com
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
GMAIL_USER_ID=me
